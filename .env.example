ROUTER_USER=
ROUTER_PASSWORD=

GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Opcionales: nombres de modelo y host de Ollama (defaults ya razonables en código)
GROQ_MODEL=openai/gpt-oss-120b
DEEPSEEK_MODEL=deepseek-flash
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# Timeouts por nivel de la cascada (segundos)
TIMEOUT_GROQ_SEGUNDOS=8
TIMEOUT_DEEPSEEK_SEGUNDOS=10
TIMEOUT_OLLAMA_SEGUNDOS=45

# Para la demo: forzar que un nivel falle y la cascada pase al siguiente.
# Ya NO se controla aquí (requeriría reiniciar el agente) sino desde
# demo_config.json, que clasificacion.py relee en cada ciclo. Ver
# demo_config.py y, si usas la interfaz web, el panel de demostración.

# Notificaciones activas (Telegram). Token de BotFather y chat_id obtenido
# con getUpdates tras mandarle /start al bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TIMEOUT_TELEGRAM_SEGUNDOS=8

# Notificación por WhatsApp/Twilio: DESACTIVADA (ver notificacion_twilio.py).
# Se dejan las variables por si se retoma más adelante.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_TO=
